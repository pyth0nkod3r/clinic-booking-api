# Copy to .env and fill in. One file drives both API and web in local dev.
DATABASE_URL="postgres://user:pass@host/db?sslmode=require"
API_KEY=kc_local_dev_key
# Vite reads VITE_* from this same file (vite envDir points at the repo root)
VITE_API_BASE="http://127.0.0.1:8765"
VITE_API_KEY=kc_local_dev_key
